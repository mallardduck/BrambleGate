package ui

import (
	"fmt"
	"strings"
	"time"

	"github.com/mallardduck/BrambleGate/internal/acme"
	"github.com/mallardduck/BrambleGate/internal/dnsstamp"
	"github.com/mallardduck/BrambleGate/model"
)

// DashboardData is everything the dashboard page needs to render.
type DashboardData struct {
	Settings    model.Settings
	RecordCount int
	MDNSCount   int // discovered entries; 0 when mDNS is disabled
	Cert        acme.Status
	// ACMESelfRecords is what would be auto-answered locally for
	// settings.ACME.Domain right now, detected from local interfaces
	// (selfip) — never stored in records.yaml. Empty when ACME is
	// off/unconfigured, or when nothing was detected (e.g. bridge-mode
	// deployments). See Service.ACMESelfRecords.
	ACMESelfRecords []model.Record
}

// IsDefaultUpstream reports whether the upstream forwarder is still the
// seeded onboarding default (model.DefaultSettings), meaning the user hasn't
// pointed BrambleGate at their own resolver yet.
func (d DashboardData) IsDefaultUpstream() bool {
	def := model.DefaultSettings()
	return d.Settings.UpstreamDNS.Address == def.UpstreamDNS.Address
}

templ Dashboard(data DashboardData) {
	if data.IsDefaultUpstream() {
		<div class="mb-6 rounded border border-bramble-primary/40 bg-bramble-primary/10 px-4 py-3 text-sm flex items-center justify-between gap-4">
			<span>
				Still forwarding to the default upstream ({ data.Settings.UpstreamDNS.Address }). Point BrambleGate at your
				own ad-block resolver to finish setup.
			</span>
			<a href={ templ.SafeURL(PathSettings) } class="shrink-0 px-3 py-1.5 rounded border border-bramble-primary text-bramble-primary text-xs font-semibold hover:bg-bramble-primary/10">
				Go to settings
			</a>
		</div>
	}
	<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
		@statCard("Records", fmt.Sprintf("%d", data.RecordCount), PathRecords)
		@statCard("VLANs", fmt.Sprintf("%d", len(data.Settings.VLANs)), PathSettings)
		if data.Settings.MDNS.Enabled {
			@statCard("mDNS discovered", fmt.Sprintf("%d", data.MDNSCount), PathMDNS)
		} else {
			@statCard("mDNS", "disabled", PathSettings)
		}
	</div>
	<div class="mt-8 rounded border border-bramble-border bg-bramble-bg-card shadow-sm p-4">
		<h2 class="text-sm font-semibold mb-3">Listeners</h2>
		<table class="w-full text-sm">
			<thead>
				<tr class="border-b border-bramble-border text-left text-xs text-bramble-muted uppercase tracking-wide font-semibold">
					<th class="px-3 py-2">Protocol</th>
					<th class="px-3 py-2">Status</th>
					<th class="px-3 py-2 text-right">Port</th>
				</tr>
			</thead>
			<tbody>
				@listenerRow("Plain", data.Settings.Listeners.Plain, false)
				@listenerRow("DoH", data.Settings.Listeners.DoH, true)
				@listenerRow("DoH3", data.Settings.Listeners.DoH3.Listener, false)
				@listenerRow("DoT", data.Settings.Listeners.DoT, true)
				@listenerRow("DoQ", data.Settings.Listeners.DoQ.Listener, false)
			</tbody>
		</table>
	</div>
	@acmeStatusCard(data.Settings, data.Cert)
	@acmeSelfIPCard(data.Settings, data.ACMESelfRecords)
	@privateDNSCard(data.Settings)
}

// privateDNSCard is a client-configuration cheat sheet for every enabled
// encrypted listener: the sdns:// stamp some clients (e.g. dnscrypt-proxy)
// accept instead of separate host/port/path fields, alongside the plain
// query URL for clients that want that instead. Merged from two previously
// separate cards (DNS Stamps, Default Query URLs) that always listed the
// same protocols side by side. Pure function of settings, computed on
// render (no detection/state involved, unlike the self-IP/DDR cards above).
templ privateDNSCard(settings model.Settings) {
	if settings.ACME.Enabled && settings.ACME.Domain != "" && settings.EncryptedListenerEnabled() {
		<div class="mt-8 rounded border border-bramble-border bg-bramble-bg-card shadow-sm p-4">
			<h2 class="text-sm font-semibold mb-1">Private DNS</h2>
			<p class="text-bramble-muted text-xs mb-3">
				Point a client at this resolver over an encrypted transport — the stamp is for clients that accept an
				sdns:// URI, the query URL for everything else.
			</p>
			<div class="flex flex-col gap-3">
				if settings.Listeners.DoH.Enabled {
					@privateDNSRow("DoH", dnsstamp.DoH(settings.ACME.Domain, settings.Listeners.DoH.Port), dnsstamp.DoHURL(settings.ACME.Domain, settings.Listeners.DoH.Port))
				}
				if settings.Listeners.DoH3.Enabled {
					@privateDNSRow("DoH3", dnsstamp.DoH3(settings.ACME.Domain, settings.Listeners.DoH3.Port), dnsstamp.DoH3URL(settings.ACME.Domain, settings.Listeners.DoH3.Port))
				}
				if settings.Listeners.DoT.Enabled {
					@privateDNSRow("DoT", dnsstamp.DoT(settings.ACME.Domain, settings.Listeners.DoT.Port), dnsstamp.DoTURL(settings.ACME.Domain, settings.Listeners.DoT.Port))
				}
				if settings.Listeners.DoQ.Enabled {
					@privateDNSRow("DoQ", "", dnsstamp.DoQURL(settings.ACME.Domain, settings.Listeners.DoQ.Port))
				}
			</div>
		</div>
	}
}

// privateDNSRow groups a protocol's stamp and query URL together — stamp is
// blank for DoQ, which has no sdns:// proto type.
templ privateDNSRow(label, stamp, url string) {
	<div class="rounded bg-bramble-bg px-3 py-2">
		<p class="text-xs font-semibold uppercase tracking-wide mb-2">{ label }</p>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
			@dnsStampField("Query URL", url)
			if stamp != "" {
				@dnsStampField("Stamp", stamp)
			}
		</div>
	</div>
}

templ dnsStampField(label, value string) {
	<label class="flex flex-col gap-1 text-sm">
		<span class="text-bramble-muted text-xs uppercase tracking-wide flex items-center">
			{ label }
			if label == "Query URL" {
				@helpTooltip("The plain address to enter in clients that just want a host/URL — e.g. a DoH endpoint or DoT host:port — rather than an sdns:// stamp.")
			} else if label == "Stamp" {
				@helpTooltip("An sdns:// URI that encodes this resolver's protocol, address and certificate info in one string — paste it into clients that support DNSCrypt-style stamps (e.g. dnscrypt-proxy).")
			}
		</span>
		<input readonly value={ value } onclick="this.select()" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input font-mono text-xs"/>
	</label>
}

// acmeSelfIPCard shows what BrambleGate would answer locally, right now, for
// settings.ACME.Domain — sourced live from local interface detection
// (selfip), not from records.yaml. Only shown when ACME is enabled
// and a domain is configured (the same gate acmeStatusCard uses for its
// non-empty branch).
templ acmeSelfIPCard(settings model.Settings, records []model.Record) {
	if settings.ACME.Enabled && settings.ACME.Domain != "" {
		<div class="mt-8 rounded border border-bramble-border bg-bramble-bg-card shadow-sm p-4">
			<h2 class="text-sm font-semibold mb-3">Auto-detected address for { settings.ACME.Domain }</h2>
			if len(records) == 0 {
				<p class="text-bramble-muted text-sm">
					No local interface matched any declared VLAN (or none is configured), so nothing is auto-answered here and queries fall through to public DNS. This is expected in bridge/port-mapped deployments — add an explicit record below to point it at a LAN IP. <a href={ templ.SafeURL(PathRecords) } class="text-bramble-primary hover:underline">Add a record</a>.
				</p>
			} else {
				<p class="text-bramble-muted text-xs mb-3">
					Auto-detected from local interfaces at render time — not stored in records.yaml. To override { settings.ACME.Domain }, <a href={ templ.SafeURL(PathRecords) } class="text-bramble-primary hover:underline">add an explicit record</a>.
				</p>
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-bramble-border text-left text-xs text-bramble-muted uppercase tracking-wide font-semibold">
							<th class="px-3 py-2">Type</th>
							<th class="px-3 py-2">Default</th>
							<th class="px-3 py-2">Per-VLAN</th>
						</tr>
					</thead>
					<tbody>
						for _, r := range records {
							<tr class="border-b border-bramble-border last:border-0">
								<td class="px-3 py-2">{ string(r.Type) }</td>
								<td class="px-3 py-2 font-mono">
									if r.Default != "" {
										<span class="select-all">{ r.Default }</span>
									} else {
										—
									}
								</td>
								<td class="px-3 py-2 text-xs">
									@overridesSummary(r)
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	}
}

// acmeStatusCard summarizes the on-disk cert (independent of whether ACME is
// enabled — a self-signed placeholder shows here too) so a stale/wrong/
// expiring cert is visible without digging into logs or /config/certs.
templ acmeStatusCard(settings model.Settings, cert acme.Status) {
	<div class="mt-8 rounded border border-bramble-border bg-bramble-bg-card shadow-sm p-4">
		<h2 class="text-sm font-semibold mb-3">Certificate (ACME)</h2>
		if !settings.ACME.Enabled && (!cert.Present || cert.SelfSigned) {
			<p class="text-bramble-muted text-sm">
				ACME is disabled.
				if settings.ACME.SelfSignedFallback {
					Encrypted listeners (DoT/DoH/DoQ/DoH3) are using a self-signed placeholder certificate until it's configured.
				} else {
					Encrypted listeners (DoT/DoH/DoQ/DoH3) have no certificate and won't start until ACME or the self-signed fallback is turned on.
				}
				<a href={ templ.SafeURL(PathSettings) } class="text-bramble-primary hover:underline">Configure ACME</a>.
			</p>
		} else {
			<div class="flex flex-wrap gap-x-7 gap-y-3 text-sm">
				<div>
					<p class="text-bramble-muted text-xs uppercase tracking-wide mb-1">ACME</p>
					if settings.ACME.Enabled {
						@tag("Enabled", true)
					} else {
						@tag("Disabled", false)
					}
				</div>
				<div>
					<p class="text-bramble-muted text-xs uppercase tracking-wide mb-1">Domain</p>
					<p class="font-mono">
						if settings.ACME.Domain != "" {
							{ settings.ACME.Domain }
						} else {
							—
						}
					</p>
				</div>
				<div>
					<p class="text-bramble-muted text-xs uppercase tracking-wide mb-1 flex items-center">
						<abbr title="Discovery of Designated Resolvers" class="no-underline cursor-help">DDR</abbr>
						@helpTooltip("Discovery of Designated Resolvers (RFC 9462) — lets supporting clients auto-upgrade to DoT/DoH/DoQ/DoH3 from plain DNS")
					</p>
					if settings.ACME.Enabled && settings.ACME.Domain != "" && settings.EncryptedListenerEnabled() {
						@tag("Served", true)
					} else {
						@tag("Not served", false)
					}
				</div>
				<div>
					<p class="text-bramble-muted text-xs uppercase tracking-wide mb-1">Certificate</p>
					if !cert.Present {
						@tag("None on disk", false)
					} else if cert.SelfSigned {
						@tag("Self-signed (untrusted)", false)
					} else {
						switch cert.Environment {
							case "production":
								@tag("Production CA", true)
							case "staging":
								@tag("Staging CA (untrusted)", false)
							case "custom":
								@tag("Custom CA", false)
							default:
								@tag("CA unknown", false)
						}
					}
				</div>
				if cert.Present {
					<div>
						<p class="text-bramble-muted text-xs uppercase tracking-wide mb-1">Covers</p>
						<p class="font-mono">
							if cert.Domain != "" {
								{ cert.Domain }
							} else {
								—
							}
							if !cert.SelfSigned && settings.ACME.Domain != "" && !certCoversDomain(cert, settings.ACME.Domain) {
								<span class="text-bramble-danger ml-1">(does not match configured domain)</span>
							}
						</p>
					</div>
					<div>
						<p class="text-bramble-muted text-xs uppercase tracking-wide mb-1">Expires</p>
						<p class={ expiryClass(cert) }>
							{ cert.NotAfter.Format("2006-01-02") } ({ daysRemainingLabel(cert) })
						</p>
					</div>
				}
			</div>
		}
	</div>
}

// certCoversDomain mirrors internal/acme's unexported coversDomain — kept as a
// simple display-only check here rather than exporting Manager internals.
func certCoversDomain(cert acme.Status, domain string) bool {
	if strings.EqualFold(cert.Domain, domain) {
		return true
	}
	for _, n := range cert.DNSNames {
		if strings.EqualFold(n, domain) {
			return true
		}
	}
	return false
}

// expiryClass flags an expiring/expired cert in the danger color; a healthy
// one uses the normal text color.
func expiryClass(cert acme.Status) string {
	if cert.DaysRemaining(time.Now()) < 14 {
		return "text-bramble-danger"
	}
	return ""
}

func daysRemainingLabel(cert acme.Status) string {
	d := cert.DaysRemaining(time.Now())
	if d < 0 {
		return fmt.Sprintf("expired %d days ago", -d)
	}
	return fmt.Sprintf("%d days left", d)
}

templ statCard(label, value, href string) {
	<a href={ templ.SafeURL(href) } class="block rounded border border-bramble-border bg-bramble-bg-card shadow-sm p-4 hover:border-bramble-primary transition-colors">
		<p class="text-xs text-bramble-primary uppercase tracking-wide">{ label }</p>
		<p class="text-2xl font-heading font-semibold mt-1 tabular-nums">{ value }</p>
	</a>
}

// listenerRow renders one listener's status/port. groupStart marks the first
// row of a new default-port group (e.g. DoT/DoQ share 853, DoH/DoH3 share
// 443, per docs/deploying-docker.md's port-sharing note) with a heavier top
// border, so the table visually clusters listeners a Docker port mapping
// would combine.
templ listenerRow(label string, l model.Listener, groupStart bool) {
	<tr class={ "border-b border-bramble-border last:border-0", templ.KV("border-t-2", groupStart) }>
		<td class="px-3 py-2">{ label }</td>
		<td class="px-3 py-2">
			if l.Enabled {
				@tag("On", true)
			} else {
				@tag("Off", false)
			}
		</td>
		<td class="px-3 py-2 text-right font-mono tabular-nums">
			if l.Enabled {
				{ fmt.Sprintf("%d", l.Port) }
			} else {
				—
			}
		</td>
	</tr>
}
