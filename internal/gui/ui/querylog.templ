package ui

import (
	"fmt"
	"net"
	"strconv"
	"strings"

	"github.com/miekg/dns"

	"github.com/mallardduck/BrambleGate/model"
	"github.com/mallardduck/BrambleGate/plugins/querylog"
)

// QueryLogData is everything the live Query Log page needs to render.
type QueryLogData struct {
	Enabled bool
	Grid    QueryLogGridData
}

// QueryLogGridData backs both the initial page's table and the auto-refresh/
// filter/pagination fragment (see ui.QueryLogGrid) — one shape for both,
// since the fragment is a full outerHTML replacement of the same table body.
type QueryLogGridData struct {
	Entries    []querylog.Entry
	Total      int // total entries matching Filter, before pagination
	Page       int
	TotalPages int
	Interval   string // "2s", "5s", "10s", or "off"
	Filter     querylog.Filter
	// ListenerFilter narrows Entries to one friendly transport label (see
	// ListenerLabel) — "" means no constraint. Kept out of querylog.Filter
	// itself: querylog stays independent of model (dev-docs/repo-layout.md),
	// so it can't know "Plain"/"DoT"/etc. label-to-port mapping, only the raw
	// listener address each Entry recorded. The GUI applies this filter
	// server-side after Ring.Snapshot (see handlers_ui.go).
	ListenerFilter string
	Listeners      model.Listeners // for mapping Entry.Listener's port to a friendly transport label
	VLANs          []model.VLAN    // for the VLAN filter dropdown's options
}

// queryLogQTypeOptions is a curated subset of query types worth filtering
// by in a homelab context — not every RR type CoreDNS understands.
var queryLogQTypeOptions = []string{"A", "AAAA", "CNAME", "TXT", "PTR", "SRV", "SVCB", "HTTPS", "NS", "SOA", "MX", "ANY"}

templ QueryLog(data QueryLogData) {
	<div>
		<h1 class="text-xl font-semibold mb-4 flex items-center">
			Query Log
			@helpTooltip("Live view of DNS queries as they're answered, polled from an in-memory ring buffer (not the durable history). Auto-refresh pauses whenever you're off page 1 so it doesn't yank you back to the top.")
		</h1>
		if !data.Enabled {
			<p class="text-bramble-muted text-sm">
				The query log is disabled. Enable it in
				<a href={ templ.SafeURL(PathSettings) } class="text-bramble-primary hover:underline">Settings</a>.
			</p>
		} else {
			@queryLogFilters(data.Grid)
			@queryLogTable(data.Grid)
		}
	</div>
}

templ queryLogFilters(data QueryLogGridData) {
	<form id="querylog-filters" onsubmit="return false" class="flex flex-wrap gap-4 items-end mb-4">
		<input type="hidden" id="querylog-page" name="page" value={ strconv.Itoa(data.Page) }/>
		<label class="flex flex-col gap-1 text-sm flex-1 max-w-xs">
			<span class="text-bramble-muted text-xs">Search</span>
			<span class="relative">
				@iconSearch("w-3.5 h-3.5 absolute left-2 top-1/2 -translate-y-1/2 text-bramble-muted")
				<input id="querylog-search" name="q" value={ data.Filter.QName } oninput={ resetQueryLogPage() } placeholder="Filter by name…" class="w-full pl-7 pr-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm"/>
			</span>
		</label>
		<label class="flex flex-col gap-1 text-sm">
			<span class="text-bramble-muted text-xs">Client</span>
			<input id="querylog-client" name="client" value={ data.Filter.Client } oninput={ resetQueryLogPage() } placeholder="IP…" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm"/>
		</label>
		<label class="flex flex-col gap-1 text-sm">
			<span class="text-bramble-muted text-xs">VLAN</span>
			<select id="querylog-vlan" name="vlan" onchange={ resetQueryLogPage() } class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm">
				<option value="" selected?={ data.Filter.VLAN == "" }>All</option>
				for _, v := range data.VLANs {
					<option value={ v.Name } selected?={ data.Filter.VLAN == v.Name }>{ v.Name }</option>
				}
			</select>
		</label>
		<label class="flex flex-col gap-1 text-sm">
			<span class="text-bramble-muted text-xs">Listener</span>
			<select id="querylog-listener" name="listener" onchange={ resetQueryLogPage() } class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm">
				<option value="" selected?={ data.ListenerFilter == "" }>All</option>
				for _, l := range enabledListenerLabels(data.Listeners) {
					<option value={ l } selected?={ data.ListenerFilter == l }>{ l }</option>
				}
			</select>
		</label>
		<label class="flex flex-col gap-1 text-sm">
			<span class="text-bramble-muted text-xs">Type</span>
			<select id="querylog-qtype" name="qtype" onchange={ resetQueryLogPage() } class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm">
				<option value="" selected?={ data.Filter.QType == 0 }>All</option>
				for _, t := range queryLogQTypeOptions {
					<option value={ t } selected?={ dns.TypeToString[data.Filter.QType] == t }>{ t }</option>
				}
			</select>
		</label>
		<label class="flex flex-col gap-1 text-sm">
			<span class="text-bramble-muted text-xs">Refresh</span>
			<select id="querylog-interval" name="interval" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm">
				for _, opt := range []struct{ value, label string }{{"2s", "2s"}, {"5s", "5s"}, {"10s", "10s"}, {"off", "Paused"}} {
					<option value={ opt.value } selected?={ data.Interval == opt.value }>{ opt.label }</option>
				}
			</select>
		</label>
		<span id="querylog-count" class="text-xs text-bramble-muted whitespace-nowrap pb-1.5">{ fmt.Sprintf("%d of %d", len(data.Entries), data.Total) }</span>
	</form>
}

// resetQueryLogPage snaps the pagination back to page 1 whenever a filter
// input changes — a stale page number from a prior filter would otherwise
// often render empty (or the wrong slice) against the new, narrower result
// set. Stateless like the rest of this file's scripts: it just mutates the
// hidden #querylog-page field htmx reads on the next request.
script resetQueryLogPage() {
	const el = document.getElementById("querylog-page");
	if (el) {
		el.value = "1";
	}
}

templ queryLogTable(data QueryLogGridData) {
	<div class="rounded border border-bramble-border bg-bramble-bg-card shadow-sm overflow-x-auto">
		<table class="w-full text-sm">
			<thead>
				<tr class="border-b border-bramble-border text-left text-xs text-bramble-muted uppercase">
					<th class="px-3 py-2">Time</th>
					<th class="px-3 py-2">Client</th>
					<th class="px-3 py-2">Listener</th>
					<th class="px-3 py-2">Query</th>
					<th class="px-3 py-2">Status</th>
					<th class="px-3 py-2">Reply</th>
					<th class="px-3 py-2">DNSSEC</th>
					<th class="px-3 py-2">Latency</th>
				</tr>
			</thead>
			@queryLogTbody(data)
		</table>
	</div>
	@queryLogPagination(data)
}

// queryLogTbody is the auto-refresh/filter/pagination target: an outerHTML
// swap (not innerHTML, unlike mDNS's grid) so a changed Interval or Page
// carries a freshly server-computed hx-trigger with it — htmx only
// re-evaluates hx-trigger when the element itself is replaced.
templ queryLogTbody(data QueryLogGridData) {
	<tbody
		id="querylog-grid"
		hx-get={ PathQueryLog + "/grid" }
		hx-trigger={ queryLogPollTrigger(data.Interval, data.Page) }
		hx-include="#querylog-filters"
		hx-target="#querylog-grid"
		hx-swap="outerHTML"
	>
		@queryLogRows(data.Entries, data.Listeners)
	</tbody>
}

// queryLogPollTrigger builds the tbody's hx-trigger: an "every {interval}"
// auto-poll only while Interval isn't paused AND Page is 1 (per this page's
// own tooltip — auto-refresh must not yank a scrolled/paginated view back to
// the top), plus the filter-input listeners that always apply regardless of
// pagination/refresh state.
func queryLogPollTrigger(interval string, page int) string {
	triggers := []string{
		"keyup changed delay:300ms from:#querylog-search",
		"keyup changed delay:300ms from:#querylog-client",
		"change from:#querylog-vlan",
		"change from:#querylog-listener",
		"change from:#querylog-qtype",
		"change from:#querylog-interval",
	}
	if interval != "off" && page == 1 {
		triggers = append([]string{"every " + interval}, triggers...)
	}
	return strings.Join(triggers, ", ")
}

// queryLogRows renders just the table body's rows — used both for the
// initial page render and, as the base of QueryLogGrid below, for the
// auto-refresh/filter/pagination fragment.
templ queryLogRows(entries []querylog.Entry, listeners model.Listeners) {
	for _, e := range entries {
		@queryLogRow(e, listeners)
	}
	if len(entries) == 0 {
		<tr>
			<td colspan="8" class="px-3 py-4 text-center text-bramble-muted">No queries match.</td>
		</tr>
	}
}

// QueryLogGrid is the response for the auto-refresh/filter/pagination poll
// (see PathQueryLog+"/grid" in internal/gui): the replacement tbody (see
// queryLogTbody) plus out-of-band updates of the count and pagination
// controls. Must only be used for that fragment response, never the initial
// page render.
templ QueryLogGrid(data QueryLogGridData) {
	@queryLogTbody(data)
	<span id="querylog-count" hx-swap-oob="true" class="text-xs text-bramble-muted whitespace-nowrap pb-1.5">{ fmt.Sprintf("%d of %d", len(data.Entries), data.Total) }</span>
	@queryLogPaginationOOB(data)
}

templ queryLogPagination(data QueryLogGridData) {
	<div id="querylog-pagination" class="flex items-center justify-end gap-2 mt-2 text-xs text-bramble-muted">
		@queryLogPaginationInner(data)
	</div>
}

templ queryLogPaginationOOB(data QueryLogGridData) {
	<div id="querylog-pagination" hx-swap-oob="true" class="flex items-center justify-end gap-2 mt-2 text-xs text-bramble-muted">
		@queryLogPaginationInner(data)
	</div>
}

templ queryLogPaginationInner(data QueryLogGridData) {
	<button
		type="button"
		disabled?={ data.Page <= 1 }
		hx-get={ PathQueryLog + "/grid" }
		hx-vals={ fmt.Sprintf(`{"page":%d}`, data.Page-1) }
		hx-include="#querylog-filters"
		hx-target="#querylog-grid"
		hx-swap="outerHTML"
		class="px-2 py-1 rounded border border-bramble-border disabled:opacity-40 hover:text-bramble-primary transition-colors"
	>
		Prev
	</button>
	<span>{ fmt.Sprintf("Page %d of %d", data.Page, data.TotalPages) }</span>
	<button
		type="button"
		disabled?={ data.Page >= data.TotalPages }
		hx-get={ PathQueryLog + "/grid" }
		hx-vals={ fmt.Sprintf(`{"page":%d}`, data.Page+1) }
		hx-include="#querylog-filters"
		hx-target="#querylog-grid"
		hx-swap="outerHTML"
		class="px-2 py-1 rounded border border-bramble-border disabled:opacity-40 hover:text-bramble-primary transition-colors"
	>
		Next
	</button>
}

templ queryLogRow(e querylog.Entry, listeners model.Listeners) {
	<tr class="border-b border-bramble-border last:border-0">
		<td class="px-3 py-2 font-mono text-xs whitespace-nowrap">{ e.Timestamp.Format("15:04:05.000") }</td>
		<td class="px-3 py-2">
			<p class="font-mono text-xs">{ e.Client.IP }</p>
			if e.Client.VLAN != "" {
				<p class="text-xs text-bramble-muted">{ e.Client.VLAN }</p>
			}
		</td>
		<td class="px-3 py-2 text-xs whitespace-nowrap" title={ e.Listener + " (" + e.Proto + ")" }>{ ListenerLabel(e.Listener, listeners) }</td>
		<td class="px-3 py-2">
			<p class="font-mono text-sm break-all">{ e.QName }</p>
			<p class="text-xs text-bramble-muted">{ dns.TypeToString[e.QType] }</p>
		</td>
		<td class="px-3 py-2">
			<p class="text-xs">{ outcomeLabel(e.Source, e.Verdict) }</p>
			<p class="text-xs text-bramble-muted">{ dns.RcodeToString[e.Rcode] }</p>
		</td>
		<td class="px-3 py-2 text-xs">
			if e.AnswerType != "" {
				{ e.AnswerType }
			} else {
				<span class="text-bramble-muted">—</span>
			}
		</td>
		<td class="px-3 py-2">
			if e.AuthenticatedData {
				@tag("AD", true)
			} else {
				<span class="text-bramble-muted text-xs">—</span>
			}
		</td>
		<td class="px-3 py-2 text-xs whitespace-nowrap">{ e.Latency.String() }</td>
	</tr>
}

// enabledListenerLabels returns the friendly labels (see ListenerLabel) of
// every currently-enabled listener, in the same fixed Plain/DoT/DoH/DoQ/DoH3
// order configgen renders server blocks in — used to populate the Query Log
// page's listener filter dropdown (handlers_ui.go applies the actual filter
// server-side, since querylog.Filter can't carry a model-aware label).
func enabledListenerLabels(l model.Listeners) []string {
	var out []string
	if l.Plain.Enabled {
		out = append(out, "Plain")
	}
	if l.DoT.Enabled {
		out = append(out, "DoT")
	}
	if l.DoH.Enabled {
		out = append(out, "DoH")
	}
	if l.DoQ.Enabled {
		out = append(out, "DoQ")
	}
	if l.DoH3.Enabled {
		out = append(out, "DoH3")
	}
	return out
}

// ListenerLabel maps Entry.Listener's port back to a friendly transport name
// using the settings the GUI already has (Entry itself can't carry this —
// querylog stays independent of model, dev-docs/repo-layout.md). Falls back
// to the raw ":port" when it doesn't match any currently-enabled listener
// (e.g. settings changed since the query was logged). Exported so
// handlers_ui.go can apply the same mapping when filtering by listener.
func ListenerLabel(listener string, l model.Listeners) string {
	_, portStr, err := net.SplitHostPort(listener)
	if err != nil {
		return listener
	}
	port, err := strconv.Atoi(portStr)
	if err != nil {
		return listener
	}
	switch {
	case l.Plain.Enabled && l.Plain.Port == port:
		return "Plain"
	case l.DoT.Enabled && l.DoT.Port == port:
		return "DoT"
	case l.DoH.Enabled && l.DoH.Port == port:
		return "DoH"
	case l.DoQ.Enabled && l.DoQ.Port == port:
		return "DoQ"
	case l.DoH3.Enabled && l.DoH3.Port == port:
		return "DoH3"
	default:
		return ":" + portStr
	}
}

// sourceLabel maps querylog's raw Source values to slightly friendlier
// display text for the "By Source" chart legend (a per-plugin breakdown, so
// e.g. "vlancache" is deliberately its own slice there); unrecognized values
// (open enum — dev-docs/query-log.md) pass through as-is rather than showing
// blank.
func sourceLabel(source string) string {
	switch source {
	case "localrecords":
		return "Local record"
	case "mdnsbridge":
		return "mDNS"
	case "hosts":
		return "Static host"
	case "cache":
		return "Cache"
	case "vlancache":
		return "VLAN cache"
	case "forward":
		return "Forwarded upstream"
	case "":
		return "—"
	default:
		return source
	}
}

// outcomeLabel renders a query log row's outcome as friendly display text.
// self-attributing plugins (localrecords, mdnsbridge) are identified by
// Source; the forward/cache path — including vlancache, whose Source is
// always "vlancache" regardless of outcome (dev-docs/query-log.md) — is
// identified by Verdict instead, since that's what actually distinguishes a
// cache hit from a real upstream call from a deduped-in-flight one (unlike
// sourceLabel above, which exists for the per-plugin chart breakdown, not
// this per-query outcome). An unrecognized verdict (open enum) passes
// through as-is rather than showing blank.
func outcomeLabel(source, verdict string) string {
	switch source {
	case "localrecords":
		return "Local record"
	case "mdnsbridge":
		return "mDNS"
	case "hosts":
		return "Static host"
	}
	switch verdict {
	case "cached":
		return "Cache"
	case "coalesced":
		return "Cache (coalesced)"
	case "forwarded", "nxdomain":
		return "Forwarded upstream"
	case "":
		return "—"
	default:
		return verdict
	}
}
