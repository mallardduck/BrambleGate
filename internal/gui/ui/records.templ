package ui

import (
	"fmt"
	"strconv"

	"github.com/mallardduck/BrambleGate/model"
)

// RecordsData is everything the records page needs to render. Editing is nil
// for the "add a record" state; set it (from a GET .../edit request) to
// pre-fill the form for an update.
type RecordsData struct {
	Records model.RecordSet
	VLANs   []model.VLAN
	Editing *model.Record
}

templ Records(data RecordsData) {
	<h1 class="text-lg font-semibold mb-4">Records</h1>
	<div class="rounded border border-bramble-border bg-bramble-bg-card shadow-sm overflow-x-auto">
		<table class="w-full text-sm">
			<thead>
				<tr class="border-b border-bramble-border text-left text-xs text-bramble-muted uppercase tracking-wide">
					<th class="px-3 py-2">Name</th>
					<th class="px-3 py-2">Type</th>
					<th class="px-3 py-2">Default</th>
					<th class="px-3 py-2">TTL</th>
					<th class="px-3 py-2">Per-VLAN</th>
					<th class="px-3 py-2"></th>
				</tr>
			</thead>
			<tbody>
				for _, r := range data.Records.Records {
					@recordRow(r)
				}
				if len(data.Records.Records) == 0 {
					<tr>
						<td colspan="6" class="px-3 py-4 text-center text-bramble-muted">No records yet.</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	@recordForm(data)

	if len(data.Records.Records) > 0 {
		<p class="mt-3 text-xs text-bramble-muted">Changes are saved to records.yaml and applied live — no restart required.</p>
	}
}

templ recordRow(r model.Record) {
	<tr class="border-b border-bramble-border last:border-0">
		<td class="px-3 py-2 font-mono">{ r.Name }</td>
		<td class="px-3 py-2">{ string(r.Type) }</td>
		<td class="px-3 py-2 font-mono">
			if r.Default != "" {
				<span class="select-all">{ r.Default }</span>
			} else {
				—
			}
		</td>
		<td class="px-3 py-2">
			if r.TTL != 0 {
				{ strconv.Itoa(int(r.TTL)) }
			} else {
				300
			}
		</td>
		<td class="px-3 py-2 text-xs">
			@overridesSummary(r)
		</td>
		<td class="px-3 py-2 text-right whitespace-nowrap">
			<a
				href={ templ.SafeURL(RecordPath(r.Name, string(r.Type)) + "/edit") }
				hx-get={ RecordPath(r.Name, string(r.Type)) + "/edit" }
				hx-target="#content"
				hx-swap="innerHTML"
				class="inline-flex items-center gap-1 text-bramble-primary hover:underline text-xs mr-3"
			>
				@iconPencil("w-3 h-3")
				Edit
			</a>
			<button
				hx-delete={ RecordPath(r.Name, string(r.Type)) }
				hx-target="#content"
				hx-swap="innerHTML"
				hx-confirm={ fmt.Sprintf("Delete %s record %s?", r.Type, r.Name) }
				type="button"
				class="inline-flex items-center gap-1 text-bramble-danger hover:underline text-xs"
			>
				@iconTrash("w-3 h-3")
				Delete
			</button>
		</td>
	</tr>
}

// overridesSummary lists each VLAN override as "vlan: value" — the value is
// wrapped in its own select-all span so a double-click grabs the whole IP
// (browsers otherwise break word-selection on the dots) instead of a
// fragment of it.
templ overridesSummary(r model.Record) {
	if len(r.VLANOverrides) == 0 {
		—
	} else {
		for i, o := range r.VLANOverrides {
			if i > 0 {
				{ ", " }
			}
			{ o.VLAN }: <span class="select-all">{ overrideValue(o) }</span>
		}
	}
}

func overrideValue(o model.VLANOverride) string {
	switch {
	case o.NXDomain:
		return "✗"
	case o.Value != "":
		return o.Value
	default:
		return "(dflt)"
	}
}

templ recordForm(data RecordsData) {
	{{
		name, rtype, def, ttl := "", "A", "", ""
		var overrides []model.VLANOverride
		if data.Editing != nil {
			name = data.Editing.Name
			rtype = string(data.Editing.Type)
			def = data.Editing.Default
			if data.Editing.TTL != 0 {
				ttl = strconv.Itoa(int(data.Editing.TTL))
			}
			overrides = data.Editing.VLANOverrides
		}
	}}
	<form
		if data.Editing != nil {
			hx-put={ RecordPath(data.Editing.Name, string(data.Editing.Type)) }
		} else {
			hx-post={ PathRecords }
		}
		hx-target="#content"
		hx-swap="innerHTML"
		class="mt-6 rounded border border-bramble-border bg-bramble-bg-card shadow-sm p-4"
	>
		<h2 class="text-sm font-semibold mb-3">
			if data.Editing != nil {
				Edit { rtype } { name }
			} else {
				Add a record
			}
		</h2>
		<div class="flex flex-wrap gap-3 items-end">
			<label class="flex flex-col gap-1 text-sm">
				<span class="text-bramble-muted text-xs">Name</span>
				<input name="name" value={ name } placeholder="nas.home.arpa" required class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm min-w-[180px]"/>
			</label>
			<label class="flex flex-col gap-1 text-sm">
				<span class="text-bramble-muted text-xs">Type</span>
				<div class="flex rounded border border-bramble-border overflow-hidden">
					@segOption("type", "A", "A", rtype == "A")
					@segOption("type", "AAAA", "AAAA", rtype == "AAAA")
					@segOption("type", "CNAME", "CNAME", rtype == "CNAME")
				</div>
			</label>
			<label class="flex flex-col gap-1 text-sm">
				<span class="text-bramble-muted text-xs">Default value</span>
				<input name="default" value={ def } placeholder="192.168.10.20" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm min-w-[160px]"/>
			</label>
			<label class="flex flex-col gap-1 text-sm">
				<span class="text-bramble-muted text-xs">TTL (blank = 300)</span>
				<input name="ttl" type="number" min="1" value={ ttl } placeholder="300" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm w-24"/>
			</label>
		</div>

		if len(data.VLANs) > 0 {
			<fieldset class="mt-4 border border-bramble-border rounded p-3">
				<legend class="text-xs text-bramble-muted px-1">Per-VLAN overrides</legend>
				<div class="grid grid-cols-[120px_100px_1fr_100px] gap-2 items-center text-sm">
					for _, v := range data.VLANs {
						@overrideRow(v, findOverride(overrides, v.Name))
					}
				</div>
			</fieldset>
		} else {
			<p class="mt-3 text-xs text-bramble-muted">Define VLANs in Settings to enable per-VLAN overrides.</p>
		}

		<div class="mt-4 flex gap-2">
			<button type="submit" class="px-3 py-1.5 rounded border border-bramble-primary text-bramble-primary text-sm font-medium hover:bg-bramble-primary/10">
				if data.Editing != nil {
					Save changes
				} else {
					Add record
				}
			</button>
			if data.Editing != nil {
				<a href={ templ.SafeURL(PathRecords) } hx-get={ PathRecords } hx-target="#content" hx-swap="innerHTML" class="px-3 py-1.5 rounded border border-bramble-border text-sm">
					Cancel
				</a>
			}
		</div>
	</form>
}

func findOverride(overrides []model.VLANOverride, vlan string) model.VLANOverride {
	for _, o := range overrides {
		if o.VLAN == vlan {
			return o
		}
	}
	return model.VLANOverride{VLAN: vlan}
}

templ overrideRow(v model.VLAN, o model.VLANOverride) {
	<span class="font-mono text-xs">{ v.Name }</span>
	<label class="flex items-center gap-1 text-xs">
		<input type="checkbox" name={ "override_nx_" + v.Name } checked?={ o.NXDomain }/>
		NXDOMAIN
	</label>
	<input
		type="text"
		name={ "override_value_" + v.Name }
		value={ o.Value }
		placeholder="inherit default"
		class="px-2 py-1 rounded border border-bramble-border bg-bramble-bg-input text-xs"
	/>
	<input
		type="number"
		min="1"
		name={ "override_ttl_" + v.Name }
		if o.TTL != 0 {
			value={ strconv.Itoa(int(o.TTL)) }
		}
		placeholder="inherit TTL"
		class="px-2 py-1 rounded border border-bramble-border bg-bramble-bg-input text-xs"
	/>
}
