package ui

import (
	"strings"

	"github.com/mallardduck/BrambleGate/plugins/mdnsbridge"
)

// MDNSData is everything the mDNS discovery page needs to render.
type MDNSData struct {
	Enabled bool
	Entries []mdnsbridge.Entry
}

templ MDNS(data MDNSData) {
	<div
		if data.Enabled {
			hx-get={ PathMDNS }
			hx-trigger="every 5s"
			hx-target="#content"
			hx-swap="innerHTML"
		}
	>
		<h1 class="text-lg font-semibold mb-4">Discovered devices (mDNS)</h1>
		if !data.Enabled {
			<p class="text-bramble-muted text-sm">
				mDNS discovery is disabled. Enable it in
				<a href={ templ.SafeURL(PathSettings) } class="text-bramble-primary hover:underline">Settings</a>.
			</p>
		} else {
			<p class="text-xs text-bramble-muted mb-3">
				Names seen on the network, mapped into home.arpa. Publish serves it live; Promote writes a permanent record.
			</p>
			<div class="rounded border border-bramble-border bg-bramble-bg-card overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-bramble-border text-left text-xs text-bramble-muted uppercase tracking-wide">
							<th class="px-3 py-2">Name</th>
							<th class="px-3 py-2">Host</th>
							<th class="px-3 py-2">Service</th>
							<th class="px-3 py-2">Addresses</th>
							<th class="px-3 py-2">Served</th>
							<th class="px-3 py-2"></th>
						</tr>
					</thead>
					<tbody>
						for _, e := range data.Entries {
							@mdnsRow(e)
						}
						if len(data.Entries) == 0 {
							<tr>
								<td colspan="6" class="px-3 py-4 text-center text-bramble-muted">Nothing discovered yet.</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ mdnsRow(e mdnsbridge.Entry) {
	<tr class="border-b border-bramble-border last:border-0">
		<td class="px-3 py-2 font-mono">{ e.Name }</td>
		<td class="px-3 py-2 font-mono">{ e.Host }</td>
		<td class="px-3 py-2">{ e.Service }</td>
		<td class="px-3 py-2 font-mono">{ strings.Join(append(append([]string{}, e.IPv4...), e.IPv6...), ", ") }</td>
		<td class="px-3 py-2">
			if e.Published {
				✓
			} else {
				—
			}
		</td>
		<td class="px-3 py-2 text-right whitespace-nowrap">
			<button
				hx-post={ MDNSActionPath(e.Name, publishAction(e.Published)) }
				hx-target="#content"
				hx-swap="innerHTML"
				type="button"
				class="text-bramble-primary hover:underline text-xs mr-3"
			>
				if e.Published {
					Unpublish
				} else {
					Publish
				}
			</button>
			<button
				hx-post={ MDNSActionPath(e.Name, "promote") }
				hx-target="#content"
				hx-swap="innerHTML"
				type="button"
				class="text-bramble-primary hover:underline text-xs"
			>
				Promote
			</button>
		</td>
	</tr>
}

func publishAction(published bool) string {
	if published {
		return "unpublish"
	}
	return "publish"
}
