package ui

import (
	"fmt"
	"strings"

	"github.com/mallardduck/BrambleGate/plugins/mdnsbridge"
)

// MDNSData is everything the mDNS discovery page needs to render.
type MDNSData struct {
	Enabled bool
	Entries []mdnsbridge.Entry
}

templ MDNS(data MDNSData) {
	<div>
		<h1 class="text-xl font-semibold mb-4 flex items-center">
			Discovered devices (mDNS)
			@helpTooltip("Names seen on the network, mapped into home.arpa. Publish serves it live while seen (lost on restart); Promote writes a durable records.yaml entry and takes over the \"served\" state shown here.")
		</h1>
		if !data.Enabled {
			<p class="text-bramble-muted text-sm">
				mDNS discovery is disabled. Enable it in
				<a href={ templ.SafeURL(PathSettings) } class="text-bramble-primary hover:underline">Settings</a>.
			</p>
		} else {
			<form id="mdns-filters" onsubmit="return false" class="flex flex-wrap gap-4 items-end mb-4">
				<label class="flex flex-col gap-1 text-sm flex-1 max-w-xs">
					<span class="text-bramble-muted text-xs">Search</span>
					<span class="relative">
						@iconSearch("w-3.5 h-3.5 absolute left-2 top-1/2 -translate-y-1/2 text-bramble-muted")
						<input id="mdns-search" name="q" placeholder="Filter by name, host or service…" class="w-full pl-7 pr-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm"/>
					</span>
				</label>
				<div class="flex rounded border border-bramble-border overflow-hidden">
					@segOption("status", "all", "All", true)
					@segOption("status", "served", "Served", false)
					@segOption("status", "unserved", "Not served", false)
				</div>
				<span id="mdns-count" class="text-xs text-bramble-muted whitespace-nowrap pb-1.5">{ fmt.Sprintf("%d of %d", len(data.Entries), len(data.Entries)) }</span>
			</form>
			<div class="rounded border border-bramble-border bg-bramble-bg-card shadow-sm overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-bramble-border text-left text-xs text-bramble-muted uppercase tracking-wide">
							<th class="px-3 py-2">Name</th>
							<th class="px-3 py-2">Status</th>
							<th class="px-3 py-2">Service</th>
							<th class="px-3 py-2">Addresses</th>
							<th class="px-3 py-2"></th>
						</tr>
					</thead>
					<tbody
						id="mdns-grid"
						hx-get={ PathMDNS + "/grid" }
						hx-trigger="every 10s, keyup changed delay:300ms from:#mdns-search, change from:[name='status']"
						hx-include="#mdns-filters"
						hx-target="#mdns-grid"
						hx-swap="innerHTML"
					>
						@mdnsRows(data.Entries, false)
					</tbody>
				</table>
			</div>
		}
	</div>
}

// mdnsRows renders just the table body's rows (no count span) — used both
// for the initial page render and, as the base of MDNSGrid below, for the
// auto-refresh/filter fragment. filtered distinguishes "nothing discovered
// at all" from "nothing matches the current filter".
templ mdnsRows(entries []mdnsbridge.Entry, filtered bool) {
	for _, e := range entries {
		@mdnsRow(e)
	}
	if len(entries) == 0 {
		<tr>
			<td colspan="5" class="px-3 py-4 text-center text-bramble-muted">
				if filtered {
					Nothing matches this filter.
				} else {
					Nothing discovered yet.
				}
			</td>
		</tr>
	}
}

// MDNSGrid is the response for the auto-refresh/filter poll (see
// PathMDNS+"/grid" in internal/gui): rows plus an out-of-band update of the
// "N of total" count in the filter form above (see mdns-count in MDNS).
// It must only be used for that fragment response, never the initial page
// render — outside of an actual htmx swap, hx-swap-oob has no effect and the
// span would just render twice.
templ MDNSGrid(entries []mdnsbridge.Entry, filtered bool, total int) {
	@mdnsRows(entries, filtered)
	<span id="mdns-count" hx-swap-oob="true" class="text-xs text-bramble-muted whitespace-nowrap pb-1.5">{ fmt.Sprintf("%d of %d", len(entries), total) }</span>
}

templ mdnsRow(e mdnsbridge.Entry) {
	<tr class="border-b border-bramble-border last:border-0">
		<td class="px-3 py-2">
			<p class="font-mono text-sm break-all">{ e.Name }</p>
			<p class="text-xs text-bramble-muted break-all">{ e.Host }</p>
		</td>
		<td class="px-3 py-2">
			if e.Promoted {
				@tag("Served (promoted)", true)
			} else if e.Published {
				@tag("Served", true)
			} else {
				@tag("Not served", false)
			}
		</td>
		<td class="px-3 py-2 text-xs">{ e.Service }</td>
		<td class="px-3 py-2 font-mono text-xs whitespace-nowrap" title={ strings.Join(mdnsAddrs(e), ", ") }>{ shortAddrs(mdnsAddrs(e)) }</td>
		<td class="px-3 py-2 text-right whitespace-nowrap">
			if e.Promoted {
				<span title="Promoted names are managed from the Records tab — publish/unpublish and re-promoting have no effect here" class="text-bramble-muted text-xs">
					Managed in
					<a href={ templ.SafeURL(PathRecords) } hx-get={ PathRecords } hx-target="#content" hx-swap="innerHTML" class="text-bramble-primary hover:underline">Records</a>
				</span>
			} else {
				<button
					hx-post={ MDNSActionPath(e.Name, publishAction(e.Published)) }
					hx-target="#content"
					hx-swap="innerHTML"
					type="button"
					title={ publishTitle(e.Published) }
					class="text-bramble-primary hover:underline text-xs mr-3"
				>
					if e.Published {
						Unpublish
					} else {
						Publish
					}
				</button>
				<button
					hx-post={ MDNSActionPath(e.Name, "promote") }
					hx-target="#content"
					hx-swap="innerHTML"
					type="button"
					title="Claim this name as authoritative: still resolves from live mDNS matches, but returns NODATA instead of falling through when the device isn't currently seen"
					class="text-bramble-primary hover:underline text-xs"
				>
					Promote
				</button>
			}
		</td>
	</tr>
}

func mdnsAddrs(e mdnsbridge.Entry) []string {
	return append(append([]string{}, e.IPv4...), e.IPv6...)
}

// shortAddrs shows just the first address plus a "+N more" count when there
// are several — the full list is still available via the cell's title
// attribute (hover) rather than wrapping the row onto multiple lines.
func shortAddrs(addrs []string) string {
	if len(addrs) <= 1 {
		return strings.Join(addrs, ", ")
	}
	return fmt.Sprintf("%s +%d more", addrs[0], len(addrs)-1)
}

func publishAction(published bool) string {
	if published {
		return "unpublish"
	}
	return "publish"
}

func publishTitle(published bool) string {
	if published {
		return "Stop serving this name; queries fall through to the rest of the chain when it drops off mDNS"
	}
	return "Serve this name while it's seen on mDNS; falls through to the rest of the chain once it drops off"
}