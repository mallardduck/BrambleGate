package ui

import (
	"strings"

	"github.com/mallardduck/BrambleGate/plugins/mdnsbridge"
)

// MDNSData is everything the mDNS discovery page needs to render.
type MDNSData struct {
	Enabled bool
	Entries []mdnsbridge.Entry
}

templ MDNS(data MDNSData) {
	<div>
		<h1 class="text-lg font-semibold mb-4">Discovered devices (mDNS)</h1>
		if !data.Enabled {
			<p class="text-bramble-muted text-sm">
				mDNS discovery is disabled. Enable it in
				<a href={ templ.SafeURL(PathSettings) } class="text-bramble-primary hover:underline">Settings</a>.
			</p>
		} else {
			<p class="text-xs text-bramble-muted mb-3">
				Names seen on the network, mapped into home.arpa. Publish serves it live while seen (lost on restart); Promote writes a durable records.yaml entry and takes over the "served" state shown here.
			</p>
			<form id="mdns-filters" onsubmit="return false" class="flex flex-wrap gap-4 items-end mb-4">
				<label class="flex flex-col gap-1 text-sm flex-1 max-w-xs">
					<span class="text-bramble-muted text-xs">Search</span>
					<span class="relative">
						@iconSearch("w-3.5 h-3.5 absolute left-2 top-1/2 -translate-y-1/2 text-bramble-muted")
						<input id="mdns-search" name="q" placeholder="Filter by name, host or service…" class="w-full pl-7 pr-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm"/>
					</span>
				</label>
				<div class="flex rounded border border-bramble-border overflow-hidden">
					@segOption("status", "all", "All", true)
					@segOption("status", "served", "Served", false)
					@segOption("status", "unserved", "Not served", false)
				</div>
			</form>
			<div
				id="mdns-grid"
				hx-get={ PathMDNS + "/grid" }
				hx-trigger="every 10s, keyup changed delay:300ms from:#mdns-search, change from:[name='status']"
				hx-include="#mdns-filters"
				hx-target="#mdns-grid"
				hx-swap="innerHTML"
				class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3"
			>
				@MDNSGrid(data.Entries, false)
			</div>
		}
	</div>
}

// MDNSGrid renders just the card grid's children, so the 10s auto-refresh (and
// the search/status filter, see the form above) can fetch and swap this alone
// (see PathMDNS+"/grid" in internal/gui). Swapping only this node — rather
// than the whole page's #content — keeps the outer heading/copy and the
// page's scroll position stable across refreshes. filtered distinguishes
// "nothing discovered at all" from "nothing matches the current filter".
templ MDNSGrid(entries []mdnsbridge.Entry, filtered bool) {
	for _, e := range entries {
		@mdnsCard(e)
	}
	if len(entries) == 0 {
		if filtered {
			<p class="text-bramble-muted text-sm col-span-full">Nothing matches this filter.</p>
		} else {
			<p class="text-bramble-muted text-sm col-span-full">Nothing discovered yet.</p>
		}
	}
}

templ mdnsCard(e mdnsbridge.Entry) {
	<div class="rounded border border-bramble-border bg-bramble-bg-card shadow-sm p-4 flex flex-col gap-2">
		<div class="flex items-start justify-between gap-2">
			<p class="font-mono text-sm font-medium break-all">{ e.Name }</p>
			if e.Promoted {
				<span title="A records.yaml record resolves this name from live mDNS matches" class="shrink-0 text-xs px-1.5 py-0.5 rounded bg-bramble-primary/10 text-bramble-primary whitespace-nowrap">Served (promoted)</span>
			} else if e.Published {
				<span class="shrink-0 text-xs px-1.5 py-0.5 rounded bg-bramble-primary/10 text-bramble-primary whitespace-nowrap">Served</span>
			} else {
				<span class="shrink-0 text-xs px-1.5 py-0.5 rounded bg-bramble-bg-card2 text-bramble-muted whitespace-nowrap">Not served</span>
			}
		</div>
		<dl class="text-xs space-y-1">
			<div class="flex gap-1">
				<dt class="text-bramble-muted shrink-0">Host:</dt>
				<dd class="font-mono break-all">{ e.Host }</dd>
			</div>
			<div class="flex gap-1">
				<dt class="text-bramble-muted shrink-0">Service:</dt>
				<dd class="break-all">{ e.Service }</dd>
			</div>
			<div class="flex gap-1">
				<dt class="text-bramble-muted shrink-0">Addrs:</dt>
				<dd class="font-mono break-all">{ strings.Join(append(append([]string{}, e.IPv4...), e.IPv6...), ", ") }</dd>
			</div>
		</dl>
		<div class="mt-auto pt-2 border-t border-bramble-border flex gap-3">
			if e.Promoted {
				<span title="Promoted names are managed from the Records tab — publish/unpublish and re-promoting have no effect here" class="text-bramble-muted text-xs">
					Managed in
					<a href={ templ.SafeURL(PathRecords) } hx-get={ PathRecords } hx-target="#content" hx-swap="innerHTML" class="text-bramble-primary hover:underline">Records</a>
				</span>
			} else {
				<button
					hx-post={ MDNSActionPath(e.Name, publishAction(e.Published)) }
					hx-target="#content"
					hx-swap="innerHTML"
					type="button"
					title={ publishTitle(e.Published) }
					class="text-bramble-primary hover:underline text-xs"
				>
					if e.Published {
						Unpublish
					} else {
						Publish
					}
				</button>
				<button
					hx-post={ MDNSActionPath(e.Name, "promote") }
					hx-target="#content"
					hx-swap="innerHTML"
					type="button"
					title="Claim this name as authoritative: still resolves from live mDNS matches, but returns NODATA instead of falling through when the device isn't currently seen"
					class="text-bramble-primary hover:underline text-xs"
				>
					Promote
				</button>
			}
		</div>
	</div>
}

func publishAction(published bool) string {
	if published {
		return "unpublish"
	}
	return "publish"
}

func publishTitle(published bool) string {
	if published {
		return "Stop serving this name; queries fall through to the rest of the chain when it drops off mDNS"
	}
	return "Serve this name while it's seen on mDNS; falls through to the rest of the chain once it drops off"
}