package ui

import (
	"strings"

	"github.com/mallardduck/BrambleGate/plugins/mdnsbridge"
)

// MDNSData is everything the mDNS discovery page needs to render.
type MDNSData struct {
	Enabled bool
	Entries []mdnsbridge.Entry
}

templ MDNS(data MDNSData) {
	<div>
		<h1 class="text-lg font-semibold mb-4">Discovered devices (mDNS)</h1>
		if !data.Enabled {
			<p class="text-bramble-muted text-sm">
				mDNS discovery is disabled. Enable it in
				<a href={ templ.SafeURL(PathSettings) } class="text-bramble-primary hover:underline">Settings</a>.
			</p>
		} else {
			<p class="text-xs text-bramble-muted mb-3">
				Names seen on the network, mapped into home.arpa. Publish serves it live; Promote writes a permanent record.
			</p>
			<div
				id="mdns-grid"
				hx-get={ PathMDNS + "/grid" }
				hx-trigger="every 10s"
				hx-target="#mdns-grid"
				hx-swap="innerHTML"
				class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3"
			>
				@MDNSGrid(data.Entries)
			</div>
		}
	</div>
}

// MDNSGrid renders just the card grid's children, so the 10s auto-refresh can
// fetch and swap this alone (see PathMDNS+"/grid" in internal/gui). Swapping
// only this node — rather than the whole page's #content — keeps the outer
// heading/copy and the page's scroll position stable across refreshes.
templ MDNSGrid(entries []mdnsbridge.Entry) {
	for _, e := range entries {
		@mdnsCard(e)
	}
	if len(entries) == 0 {
		<p class="text-bramble-muted text-sm col-span-full">Nothing discovered yet.</p>
	}
}

templ mdnsCard(e mdnsbridge.Entry) {
	<div class="rounded border border-bramble-border bg-bramble-bg-card p-4 flex flex-col gap-2">
		<div class="flex items-start justify-between gap-2">
			<p class="font-mono text-sm font-medium break-all">{ e.Name }</p>
			if e.Published {
				<span class="shrink-0 text-xs px-1.5 py-0.5 rounded bg-bramble-primary/10 text-bramble-primary whitespace-nowrap">Served</span>
			} else {
				<span class="shrink-0 text-xs px-1.5 py-0.5 rounded bg-bramble-bg-card2 text-bramble-muted whitespace-nowrap">Not served</span>
			}
		</div>
		<dl class="text-xs space-y-1">
			<div class="flex gap-1">
				<dt class="text-bramble-muted shrink-0">Host:</dt>
				<dd class="font-mono break-all">{ e.Host }</dd>
			</div>
			<div class="flex gap-1">
				<dt class="text-bramble-muted shrink-0">Service:</dt>
				<dd class="break-all">{ e.Service }</dd>
			</div>
			<div class="flex gap-1">
				<dt class="text-bramble-muted shrink-0">Addrs:</dt>
				<dd class="font-mono break-all">{ strings.Join(append(append([]string{}, e.IPv4...), e.IPv6...), ", ") }</dd>
			</div>
		</dl>
		<div class="mt-auto pt-2 border-t border-bramble-border flex gap-3">
			<button
				hx-post={ MDNSActionPath(e.Name, publishAction(e.Published)) }
				hx-target="#content"
				hx-swap="innerHTML"
				type="button"
				class="text-bramble-primary hover:underline text-xs"
			>
				if e.Published {
					Unpublish
				} else {
					Publish
				}
			</button>
			<button
				hx-post={ MDNSActionPath(e.Name, "promote") }
				hx-target="#content"
				hx-swap="innerHTML"
				type="button"
				class="text-bramble-primary hover:underline text-xs"
			>
				Promote
			</button>
		</div>
	</div>
}

func publishAction(published bool) string {
	if published {
		return "unpublish"
	}
	return "publish"
}