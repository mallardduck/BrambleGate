package ui

import (
	"sort"
	"strconv"
	"strings"

	"github.com/mallardduck/BrambleGate/model"
	"github.com/mallardduck/BrambleGate/plugins/mdnsadvertise/mdnsresponder"
	"github.com/mallardduck/BrambleGate/selfip"
)

// SettingsData is everything the settings page needs to render.
type SettingsData struct {
	Settings model.Settings
	// VLANCandidates are locally-attached networks not yet covered by any
	// declared VLAN (see Service.VLANCandidates) — suggestions only, never
	// auto-added; the user names and submits each one via the same "Add VLAN"
	// form a manual entry uses.
	VLANCandidates []selfip.Candidate
	// Editing is set when a VLAN's Edit link has been clicked: the Add-VLAN
	// form pre-fills from it and switches to a PUT-to-update submission,
	// mirroring RecordsData.Editing.
	Editing *model.VLAN
	// AdvertisedServices is what mdnsadvertise.DesiredServices computes for
	// the current settings — the exact mDNS-SD records self-advertisement
	// would publish. Shown under the mDNS self-advertisement section so the
	// effect of enabling it is visible, not just the toggle itself. Computed
	// regardless of whether advertising is enabled; the template only shows
	// it while Settings.MDNS.Advertise.Enabled is checked.
	AdvertisedServices []*mdnsresponder.ServiceSpec
}

// uint32Str renders 0 as blank (the "unset, use CoreDNS's default" state)
// rather than the literal digit, so the field round-trips to the same
// visual blank a user left it in.
func uint32Str(v uint32) string {
	if v == 0 {
		return ""
	}
	return strconv.FormatUint(uint64(v), 10)
}

// uintPtrStr renders nil as blank; unlike uint32Str, 0 itself is a real,
// distinct value (e.g. max_fails 0) so it must render as "0", not blank.
func uintPtrStr(v *uint32) string {
	if v == nil {
		return ""
	}
	return strconv.FormatUint(uint64(*v), 10)
}

// forwardTuningOpen decides the Forward tuning section's default open/closed
// state: open only when it holds a non-default value worth drawing
// attention to, closed otherwise. Server-computed so it's correct on first
// render and after every htmx swap, with no persisted "user expanded this"
// client state.
func forwardTuningOpen(u model.UpstreamTarget) bool {
	return u.MaxFails != nil || u.HealthCheckSeconds != 0 || u.ExpireSeconds != 0 || u.MaxConcurrent != 0 || u.PreferUDP
}

templ Settings(data SettingsData) {
	<h1 class="text-xl font-semibold mb-4">Settings</h1>

	<form hx-post={ PathSettings } hx-target="#content" hx-swap="innerHTML" autocomplete="off">
		<div class="rounded border border-bramble-border bg-bramble-bg-card shadow-sm p-4">
			<h2 class="text-sm font-semibold mb-3">Upstream &amp; listeners</h2>
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
				<div class="flex flex-wrap gap-3 items-end">
					<label class="flex flex-col gap-1 text-sm">
						<span class="text-bramble-muted text-xs">Upstream DNS (host:port)</span>
						<input name="upstream_address" value={ data.Settings.UpstreamDNS.Address } placeholder="192.168.10.5:53" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm min-w-[200px]"/>
					</label>
					<label class="flex flex-col gap-1 text-sm">
						<span class="text-bramble-muted text-xs">Upstream protocol</span>
						<div class="flex rounded border border-bramble-border overflow-hidden">
							@segOption("upstream_protocol", "plain", "Plain", data.Settings.UpstreamDNS.Protocol == "plain")
							@segOption("upstream_protocol", "dot", "DoT", data.Settings.UpstreamDNS.Protocol == "dot")
							@segOption("upstream_protocol", "doh", "DoH", data.Settings.UpstreamDNS.Protocol == "doh")
						</div>
					</label>
				</div>
				<div>
					<label class="flex items-center gap-2 text-sm">
						<input type="checkbox" name="upstream_ecs_enabled" checked?={ data.Settings.UpstreamDNS.ECS }/>
						Send client IP to upstream (EDNS0 Client Subnet)
					</label>
					<p class="text-bramble-danger text-xs mt-1 max-w-prose">
						Only enable this if the upstream above is a local resolver you trust (e.g. your own PiHole/AdGuard/Technitium). It reveals each client's real source IP to the upstream so it can apply per-client policy. Saving is rejected unless the upstream address is a private/loopback IP — enabling this with a public resolver (Cloudflare, Google, etc.) would leak client IPs off your network.
					</p>
				</div>
			</div>
		<details class="mt-4 group" open?={ forwardTuningOpen(data.Settings.UpstreamDNS) }>
			<summary class="text-xs font-semibold text-bramble-muted mb-2 flex items-center gap-1 cursor-pointer select-none">
				<span class="text-[10px] transition-transform group-open:rotate-90">▸</span>
				Forward tuning (optional)
				@helpTooltip("Leave a field blank to use CoreDNS's own default. max_fails 0 disables marking the upstream down on failures — sensible with a single local resolver that has no failover target anyway. \"Prefer UDP\" makes BrambleGate try UDP to the upstream first even when a client's own query arrived over TCP, retrying over TCP only if the reply comes back truncated — useful if the upstream struggles with a burst of concurrent TCP connections.")
			</summary>
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start pl-3.5">
				<div class="flex flex-wrap gap-3 items-end">
					<label class="flex flex-col gap-1 text-sm">
						<span class="text-bramble-muted text-xs">max_fails</span>
						<input name="upstream_max_fails" value={ uintPtrStr(data.Settings.UpstreamDNS.MaxFails) } placeholder="default: 2" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm w-28"/>
					</label>
					<label class="flex flex-col gap-1 text-sm">
						<span class="text-bramble-muted text-xs flex items-center">
							health_check
							@helpTooltip("How often, in seconds, to probe a failed upstream before trying it again. Blank uses CoreDNS's default (0.5s).")
						</span>
						<input name="upstream_health_check_seconds" value={ uint32Str(data.Settings.UpstreamDNS.HealthCheckSeconds) } placeholder="default: 0.5" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm w-28"/>
					</label>
					<label class="flex flex-col gap-1 text-sm">
						<span class="text-bramble-muted text-xs flex items-center">
							expire
							@helpTooltip("How long, in seconds, an upstream connection can sit idle before it's closed. Blank uses CoreDNS's default (10s).")
						</span>
						<input name="upstream_expire_seconds" value={ uint32Str(data.Settings.UpstreamDNS.ExpireSeconds) } placeholder="default: 10" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm w-28"/>
					</label>
					<label class="flex flex-col gap-1 text-sm">
						<span class="text-bramble-muted text-xs">max_concurrent</span>
						<input name="upstream_max_concurrent" value={ uint32Str(data.Settings.UpstreamDNS.MaxConcurrent) } placeholder="default: unlimited" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm w-28"/>
					</label>
				</div>
				<div>
					<label class="flex items-center gap-2 text-sm">
						<input type="checkbox" name="upstream_prefer_udp" checked?={ data.Settings.UpstreamDNS.PreferUDP }/>
						Prefer UDP to upstream
					</label>
				</div>
			</div>
		</details>
			<h3 class="text-xs font-semibold text-bramble-muted mt-4 mb-2">Listeners</h3>
			<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
				@listenerFields("plain", "Plain", data.Settings.Listeners.Plain, 53, "")
				<div class="col-span-2 flex flex-col sm:flex-row gap-3 rounded border border-dashed border-bramble-border p-2 min-w-0">
					@listenerFields("doh", "DoH", data.Settings.Listeners.DoH, 443, "DoH and DoH3 can share the same default port number (443) — the OS keeps TCP and UDP bindings separate, so this isn't a conflict. See docs/deploying-docker.md.")
					@doh3ListenerFields(data.Settings.Listeners.DoH3)
				</div>
				<div class="col-span-2 flex flex-col sm:flex-row gap-3 rounded border border-dashed border-bramble-border p-2 min-w-0">
					@listenerFields("dot", "DoT", data.Settings.Listeners.DoT, 853, "DoT and DoQ can share the same default port number (853) — the OS keeps TCP and UDP bindings separate, so this isn't a conflict. See docs/deploying-docker.md.")
					@doqListenerFields(data.Settings.Listeners.DoQ)
				</div>
			</div>
		</div>

		<div class="mt-6 rounded border border-bramble-border bg-bramble-bg-card shadow-sm p-4">
			<h2 class="text-sm font-semibold mb-3 flex items-center">
				Cache, logging &amp; errors
				@helpTooltip("By default the cache rides out brief upstream blips (serve_stale) and refreshes popular names before they expire (prefetch); repeated identical errors (e.g. upstream timeouts) are consolidated into a periodic summary instead of one line each; every query is logged to stdout; and outgoing EDNS0 UDP payload sizes are capped to 1232 bytes to avoid IP fragmentation. Each of these is on by default — the checkboxes below only turn one off if it ever causes surprising behavior for your setup. Cache is always skipped for a server block regardless of these settings when \"Send client IP to upstream\" above is enabled, since a subnet-scoped answer must never be served to a different client. Encrypted listeners (DoT/DoH/DoQ) also get a fixed, non-configurable 3-minute idle-timeout bump to help mobile/NAT'd clients — not shown here since there's nothing to toggle. Observability endpoints are off by default (opt-in instrumentation, not core behavior) and, when enabled, run on fixed ports in the first enabled listener's block only — CoreDNS treats each as a process-wide singleton.")
			</h2>
			<div class="flex flex-wrap gap-6 items-start">
				<div>
					<h3 class="text-xs font-semibold text-bramble-muted mb-2">Cache</h3>
					<label class="flex items-center gap-2 text-sm">
						<input type="checkbox" name="cache_serve_stale_disabled" checked?={ data.Settings.Cache.ServeStaleDisabled }/>
						Disable serve_stale
					</label>
					<label class="flex items-center gap-2 text-sm mt-1">
						<input type="checkbox" name="cache_prefetch_disabled" checked?={ data.Settings.Cache.PrefetchDisabled }/>
						Disable prefetch
					</label>
				</div>
				<div>
					<h3 class="text-xs font-semibold text-bramble-muted mb-2">Log</h3>
					<label class="flex items-center gap-2 text-sm">
						<input type="checkbox" name="log_disabled" checked?={ data.Settings.Log.Disabled }/>
						Disable query log
					</label>
					<label class="flex flex-col gap-1 text-sm mt-2">
						<span class="text-bramble-muted text-xs flex items-center">
							Classes
							@helpTooltip("Which query-log classes to record (e.g. success, denial, error), comma-separated. Leave blank to log every class.")
						</span>
						<input name="log_classes" value={ strings.Join(data.Settings.Log.Classes, ", ") } placeholder="success, denial, error" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm min-w-[200px]"/>
					</label>
				</div>
				<div>
					<h3 class="text-xs font-semibold text-bramble-muted mb-2">Hardening</h3>
					<label class="flex items-center gap-2 text-sm">
						<input type="checkbox" name="bufsize_disabled" checked?={ data.Settings.BufsizeDisabled }/>
						Disable EDNS0 buffer-size capping (bufsize)
					</label>
				</div>
				<div>
					<h3 class="text-xs font-semibold text-bramble-muted mb-2">Errors</h3>
					<label class="flex items-center gap-2 text-sm">
						<input type="checkbox" name="errors_consolidate_disabled" checked?={ data.Settings.Errors.ConsolidateDisabled }/>
						Disable consolidating repeated errors
					</label>
				</div>
				<div>
					<h3 class="text-xs font-semibold text-bramble-muted mb-2">Observability</h3>
					<label class="flex items-center gap-2 text-sm">
						<input type="checkbox" name="observability_health" checked?={ data.Settings.Observability.Health }/>
						Health endpoint (:9090)
					</label>
					<label class="flex items-center gap-2 text-sm mt-1">
						<input type="checkbox" name="observability_ready" checked?={ data.Settings.Observability.Ready }/>
						Readiness endpoint (:9191)
					</label>
					<label class="flex items-center gap-2 text-sm mt-1">
						<input type="checkbox" name="observability_prometheus" checked?={ data.Settings.Observability.Prometheus }/>
						Prometheus metrics (:9153)
					</label>
				</div>
			</div>
		</div>

		<div class="mt-6 rounded border border-bramble-border bg-bramble-bg-card shadow-sm p-4">
			<h2 class="text-sm font-semibold mb-3">ACME (DNS-01 certificates)</h2>
			<label class="flex items-center gap-2 text-sm">
				<input type="checkbox" name="acme_enabled" checked?={ data.Settings.ACME.Enabled } onchange={ acmeEnabledToggle() }/>
				Enabled
			</label>
			<div id="acme_self_signed_group" class="mt-3 pl-0.5" hidden?={ data.Settings.ACME.Enabled }>
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" name="acme_self_signed_fallback" checked?={ data.Settings.ACME.SelfSignedFallback }/>
					Use a self-signed certificate for encrypted listeners
					@helpTooltip("Opt-in only — off by default. With ACME disabled, DoT/DoH/DoQ/DoH3 otherwise have no certificate at all and won't start. A self-signed cert lets them come up for local testing, but strict clients (e.g. Android Private DNS) will reject it as untrusted. Mutually exclusive with ACME — turning ACME on hides and clears this.")
				</label>
			</div>
			<div id="acme_fields" class="mt-3 pl-0.5 flex flex-wrap gap-3 items-end" hidden?={ !data.Settings.ACME.Enabled }>
				<label class="flex flex-col gap-1 text-sm">
					<span class="text-bramble-muted text-xs">Domain</span>
					<input name="acme_domain" value={ data.Settings.ACME.Domain } placeholder="dns.example.com" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm"/>
				</label>
				<label class="flex flex-col gap-1 text-sm">
					<span class="text-bramble-muted text-xs">Email</span>
					<input name="acme_email" type="email" value={ data.Settings.ACME.Email } placeholder="admin@example.com" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm"/>
				</label>
				<label class="flex flex-col gap-1 text-sm">
					<span class="text-bramble-muted text-xs">DNS provider</span>
					<input name="acme_dns_provider" value={ data.Settings.ACME.DNSProvider } placeholder="cloudflare" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm"/>
				</label>
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" name="acme_production" checked?={ data.Settings.ACME.Production }/>
					Production CA
				</label>
				<label class="flex flex-col gap-1 text-sm">
					<span class="text-bramble-muted text-xs flex items-center">
						Renew before
						@helpTooltip("Start renewing the certificate this many days before it expires.")
					</span>
					<input name="acme_renew_before_days" type="number" min="1" value={ strconv.Itoa(data.Settings.ACME.RenewBeforeDays) } class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm w-24"/>
				</label>
			</div>
		</div>

		<div class="mt-6 rounded border border-bramble-border bg-bramble-bg-card shadow-sm p-4">
			<h2 class="text-sm font-semibold mb-3 flex items-center">
				mDNS discovery
				@helpTooltip("Auto-publish selectors and naming rules are YAML-only for now; discoveries can be approved/promoted individually from the mDNS page. Enabling/disabling and changing interfaces or service types take effect immediately — no restart needed.")
			</h2>
			<label class="flex items-center gap-2 text-sm">
				<input type="checkbox" name="mdns_enabled" checked?={ data.Settings.MDNS.Enabled } onchange={ toggleHiddenByChecked("mdns_fields") }/>
				Enabled
			</label>
			<div id="mdns_fields" class="mt-3 pl-0.5 flex flex-wrap gap-3 items-end" hidden?={ !data.Settings.MDNS.Enabled }>
				<label class="flex flex-col gap-1 text-sm">
					<span class="text-bramble-muted text-xs flex items-center">
						Interfaces
						@helpTooltip("Network interfaces to listen for mDNS on, comma-separated. Leave blank or type \"all\" to listen on every interface.")
					</span>
					<input name="mdns_interfaces" value={ strings.Join(data.Settings.MDNS.Interfaces, ", ") } placeholder="all" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm min-w-[200px]"/>
				</label>
				<label class="flex flex-col gap-1 text-sm">
					<span class="text-bramble-muted text-xs">Service types</span>
					<select name="mdns_service_types_mode" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm" onchange={ toggleHiddenBySelectValue("mdns_custom_group", "custom") }>
						@mdnsServiceTypesModeOption("none", "None (discovery off)", data.Settings.MDNS.ServiceTypes)
						@mdnsServiceTypesModeOption("default", "Default (curated list)", data.Settings.MDNS.ServiceTypes)
						@mdnsServiceTypesModeOption("all", "All (dynamic discovery)", data.Settings.MDNS.ServiceTypes)
						@mdnsServiceTypesModeOption("custom", "Custom list…", data.Settings.MDNS.ServiceTypes)
					</select>
				</label>
				<label id="mdns_custom_group" class="flex flex-col gap-1 text-sm" hidden?={ mdnsServiceTypesMode(data.Settings.MDNS.ServiceTypes) != "custom" }>
					<span class="text-bramble-muted text-xs flex items-center">
						Custom list
						@helpTooltip("The exact mDNS service types to discover (e.g. _http._tcp, _ipp._tcp). Only read when Service types above is set to Custom list.")
					</span>
					<input name="mdns_service_types" value={ mdnsServiceTypesCustomValue(data.Settings.MDNS.ServiceTypes) } placeholder="_http._tcp, _ipp._tcp" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm min-w-[220px]"/>
				</label>
				<label class="flex flex-col gap-1 text-sm">
					<span class="text-bramble-muted text-xs flex items-center">
						Suffix
						@helpTooltip("Domain suffix appended to discovered mDNS names. Leave blank to use the default, home.arpa.")
					</span>
					<input name="mdns_suffix" value={ data.Settings.MDNS.Suffix } placeholder="home.arpa" class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm"/>
				</label>
			</div>
		</div>

		<div class="mt-6 rounded border border-bramble-border bg-bramble-bg-card shadow-sm p-4">
			<h2 class="text-sm font-semibold mb-3 flex items-center">
				mDNS self-advertisement
				@helpTooltip("Independent of discovery above — advertises this server's own DNS service(s) via mDNS-SD so other devices/apps on the LAN can find it: plain DNS as _domain._udp/_domain._tcp, plus _dot._tcp when DoT is enabled. Off by default — broadcasting \"there is a DNS resolver here\" to the whole network segment is a bigger exposure than passively discovering other devices. Takes effect immediately — no restart needed.")
			</h2>
			<div class="flex flex-wrap gap-3 items-end">
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" name="mdns_advertise_enabled" checked?={ data.Settings.MDNS.Advertise.Enabled }/>
					Enabled
				</label>
			</div>
			if data.Settings.MDNS.Advertise.Enabled {
				<div class="mt-3 pl-0.5">
					<p class="text-bramble-muted text-xs mb-2">Currently published:</p>
					if len(data.AdvertisedServices) == 0 {
						<p class="text-bramble-muted text-sm">Nothing to advertise yet — enable a DNS listener above (plain DNS or DoT).</p>
					} else {
						<div class="flex flex-col gap-1">
							for _, svc := range data.AdvertisedServices {
								@advertisedServiceRow(svc)
							}
						</div>
					}
				</div>
			}
		</div>

		<div class="mt-4">
			<button type="submit" class="px-4 py-2 rounded border border-bramble-primary text-bramble-primary text-sm font-semibold hover:bg-bramble-primary/10">
				Save settings
			</button>
		</div>
	</form>

	<div class="mt-6 rounded border border-bramble-border bg-bramble-bg-card shadow-sm p-4">
		<h2 class="text-sm font-semibold mb-3">VLANs</h2>
		<div class="flex flex-col gap-2">
			for _, v := range data.Settings.VLANs {
				@vlanRow(v)
			}
			if len(data.Settings.VLANs) == 0 {
				<p class="text-bramble-muted text-sm">No VLANs declared — records can only have one default answer.</p>
			}
		</div>
		if data.Editing != nil {
			<form hx-put={ PathSettings + "/vlans/" + data.Editing.Name } hx-target="#content" hx-swap="innerHTML" class="mt-4 flex flex-wrap gap-2 items-end">
				<label class="flex flex-col gap-1 text-sm">
					<span class="text-bramble-muted text-xs">Name</span>
					<input name="vlan_name" value={ data.Editing.Name } placeholder="untrusted-wifi" required class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm"/>
				</label>
				<label class="flex flex-col gap-1 text-sm">
					<span class="text-bramble-muted text-xs flex items-center">
						CIDRs
						@helpTooltip("One or more CIDR ranges belonging to this VLAN, comma-separated (e.g. 192.168.20.0/24).")
					</span>
					<input name="vlan_cidrs" value={ strings.Join(data.Editing.CIDRs, ", ") } placeholder="192.168.20.0/24" required class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm min-w-[220px]"/>
				</label>
				<button type="submit" class="px-3 py-1.5 rounded border border-bramble-primary text-bramble-primary text-sm hover:bg-bramble-primary/10">
					Save changes
				</button>
				<a href={ templ.SafeURL(PathSettings) } hx-get={ PathSettings } hx-target="#content" hx-swap="innerHTML" class="px-3 py-1.5 rounded border border-bramble-border text-sm hover:bg-bramble-bg-card2">
					Cancel
				</a>
			</form>
		} else {
			<form hx-post={ PathSettings + "/vlans" } hx-target="#content" hx-swap="innerHTML" class="mt-4 flex flex-wrap gap-2 items-end">
				<label class="flex flex-col gap-1 text-sm">
					<span class="text-bramble-muted text-xs">Name</span>
					<input name="vlan_name" placeholder="untrusted-wifi" required class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm"/>
				</label>
				<label class="flex flex-col gap-1 text-sm">
					<span class="text-bramble-muted text-xs flex items-center">
						CIDRs
						@helpTooltip("One or more CIDR ranges belonging to this VLAN, comma-separated (e.g. 192.168.20.0/24).")
					</span>
					<input name="vlan_cidrs" placeholder="192.168.20.0/24" required class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm min-w-[220px]"/>
				</label>
				<button type="submit" class="px-3 py-1.5 rounded border border-bramble-primary text-bramble-primary text-sm hover:bg-bramble-primary/10">
					Add VLAN
				</button>
			</form>
		}
		if len(data.VLANCandidates) > 0 {
			<div class="mt-4 pt-4 border-t border-bramble-border">
				<p class="text-bramble-muted text-xs uppercase tracking-wide mb-2 flex items-center">
					Detected networks
					@helpTooltip("Locally-attached networks not yet declared as a VLAN (e.g. from macvlan interfaces). Name each one and add it to enable per-VLAN answers there — nothing is added automatically.")
				</p>
				<div class="flex flex-col gap-2">
					for _, c := range data.VLANCandidates {
						@vlanCandidateRow(c)
					}
				</div>
			</div>
		}
	</div>
}

templ vlanCandidateRow(c selfip.Candidate) {
	<form hx-post={ PathSettings + "/vlans" } hx-target="#content" hx-swap="innerHTML" class="flex flex-wrap gap-2 items-end rounded bg-bramble-bg px-3 py-2">
		<input type="hidden" name="vlan_cidrs" value={ c.CIDR }/>
		<label class="flex flex-col gap-1 text-sm">
			<span class="text-bramble-muted text-xs">Name</span>
			<input name="vlan_name" value={ c.Suggested } required class="px-2 py-1.5 rounded border border-bramble-border bg-bramble-bg-input text-sm"/>
		</label>
		<span class="text-bramble-muted text-sm font-mono select-all">{ c.CIDR }</span>
		<span class="text-bramble-muted text-xs">(seen at <span class="select-all">{ c.SampleIP }</span>)</span>
		<button type="submit" class="px-3 py-1.5 rounded border border-bramble-primary text-bramble-primary text-xs hover:bg-bramble-primary/10">
			Add as VLAN
		</button>
	</form>
}

templ listenerFields(prefix, label string, l model.Listener, defaultPort int, sharedPortNote string) {
	<div class="rounded bg-bramble-bg px-3 py-2 flex flex-col gap-2 min-w-0 flex-1">
		<label class="flex items-center gap-2 text-sm">
			<input
				type="checkbox"
				name={ prefix + "_enabled" }
				checked?={ l.Enabled }
				onchange={ fillDefaultPort(prefix, defaultPort) }
			/>
			{ label }
			if sharedPortNote != "" {
				@helpTooltip(sharedPortNote)
			}
		</label>
		<input
			type="number"
			id={ prefix + "_port" }
			name={ prefix + "_port" }
			if l.Port != 0 {
				value={ strconv.Itoa(l.Port) }
			}
			placeholder={ strconv.Itoa(defaultPort) }
			hidden?={ !l.Enabled }
			class="px-2 py-1 rounded border border-bramble-border bg-bramble-bg-input text-xs w-full min-w-0"
		/>
	</div>
}

// fillDefaultPort populates a listener's port field with its standard default
// (53/853/443/853) the moment the user enables it — otherwise the port field
// just shows a placeholder and looks empty/unset until they notice they need
// to type a port themselves. It also shows/hides the port field (and, for
// DoQ/DoH3, the tuning fields alongside it) as a conditional group keyed to
// this same checkbox — visibility is a pure function of the checkbox's
// current value, re-derived fresh on every render, never persisted.
script fillDefaultPort(prefix string, defaultPort int) {
	const checked = event.target.checked;
	const portInput = document.getElementById(prefix + "_port");
	if (portInput) {
		portInput.hidden = !checked;
		if (checked && !portInput.value) {
			portInput.value = defaultPort;
		}
	}
	const tuning = document.getElementById(prefix + "_tuning");
	if (tuning) {
		tuning.hidden = !checked;
	}
}

// toggleHiddenByChecked shows/hides a conditional field group keyed to a
// sibling checkbox's live value — same stateless, re-derived-on-every-render
// approach as fillDefaultPort above, just without the default-port fill.
script toggleHiddenByChecked(groupID string) {
	const el = document.getElementById(groupID);
	if (el) {
		el.hidden = !event.target.checked;
	}
}

// toggleHiddenBySelectValue shows/hides a conditional field group keyed to a
// sibling select's live value matching a specific option.
script toggleHiddenBySelectValue(groupID string, matchValue string) {
	const el = document.getElementById(groupID);
	if (el) {
		el.hidden = event.target.value !== matchValue;
	}
}

// acmeEnabledToggle is the ACME "Enabled" checkbox's onchange: it shows the
// ACME fields and hides the self-signed-fallback toggle when checked, and
// vice versa when unchecked — the two are mutually exclusive (see
// model.ACME.SelfSignedFallback), so exactly one of these groups is ever
// visible.
script acmeEnabledToggle() {
	const checked = event.target.checked;
	const fields = document.getElementById("acme_fields");
	if (fields) {
		fields.hidden = !checked;
	}
	const selfSigned = document.getElementById("acme_self_signed_group");
	if (selfSigned) {
		selfSigned.hidden = checked;
	}
}

// doqListenerFields renders the standard listener enable/port fields plus the
// DoQ-only "quic" plugin tuning knobs (max_streams/worker_pool_size). Zero
// means unset — the quic{} directive is omitted and CoreDNS's own defaults
// apply, so leaving these blank is a valid, common choice, not an error.
templ doqListenerFields(l model.QUICListener) {
	<div class="rounded bg-bramble-bg px-3 py-2 flex flex-col gap-2 min-w-0 flex-1">
		<label class="flex items-center gap-2 text-sm">
			<input
				type="checkbox"
				name="doq_enabled"
				checked?={ l.Enabled }
				onchange={ fillDefaultPort("doq", 853) }
			/>
			DoQ
		</label>
		<input
			type="number"
			id="doq_port"
			name="doq_port"
			if l.Port != 0 {
				value={ strconv.Itoa(l.Port) }
			}
			placeholder="853"
			hidden?={ !l.Enabled }
			class="px-2 py-1 rounded border border-bramble-border bg-bramble-bg-input text-xs w-full min-w-0"
		/>
		<div id="doq_tuning" class="contents" hidden?={ !l.Enabled }>
			<label class="flex flex-col gap-1 text-xs min-w-0">
				<span class="text-bramble-muted">Max streams</span>
				<input
					type="number"
					min="0"
					name="doq_max_streams"
					if l.MaxStreams != 0 {
						value={ strconv.Itoa(l.MaxStreams) }
					}
					placeholder="default"
					class="px-2 py-1 rounded border border-bramble-border bg-bramble-bg-input text-xs w-full min-w-0"
				/>
			</label>
			<label class="flex flex-col gap-1 text-xs min-w-0">
				<span class="text-bramble-muted">Worker pool size</span>
				<input
					type="number"
					min="0"
					name="doq_worker_pool_size"
					if l.WorkerPoolSize != 0 {
						value={ strconv.Itoa(l.WorkerPoolSize) }
					}
					placeholder="default"
					class="px-2 py-1 rounded border border-bramble-border bg-bramble-bg-input text-xs w-full min-w-0"
				/>
			</label>
		</div>
	</div>
}

// doh3ListenerFields is the DoH3 counterpart to doqListenerFields — same
// enable/port shape, but only max_streams (the https3 plugin's only tuning
// knob; there's no worker_pool_size equivalent, so that field is omitted
// here entirely rather than shown and silently rejected on save).
templ doh3ListenerFields(l model.QUICListener) {
	<div class="rounded bg-bramble-bg px-3 py-2 flex flex-col gap-2 min-w-0 flex-1">
		<label class="flex items-center gap-2 text-sm">
			<input
				type="checkbox"
				name="doh3_enabled"
				checked?={ l.Enabled }
				onchange={ fillDefaultPort("doh3", 443) }
			/>
			DoH3
		</label>
		<input
			type="number"
			id="doh3_port"
			name="doh3_port"
			if l.Port != 0 {
				value={ strconv.Itoa(l.Port) }
			}
			placeholder="443"
			hidden?={ !l.Enabled }
			class="px-2 py-1 rounded border border-bramble-border bg-bramble-bg-input text-xs w-full min-w-0"
		/>
		<div id="doh3_tuning" class="contents" hidden?={ !l.Enabled }>
			<label class="flex flex-col gap-1 text-xs min-w-0">
				<span class="text-bramble-muted">Max streams</span>
				<input
					type="number"
					min="0"
					name="doh3_max_streams"
					if l.MaxStreams != 0 {
						value={ strconv.Itoa(l.MaxStreams) }
					}
					placeholder="default"
					class="px-2 py-1 rounded border border-bramble-border bg-bramble-bg-input text-xs w-full min-w-0"
				/>
			</label>
		</div>
	</div>
}

// advertisedServiceTXT renders a ServiceSpec's TXT records as "k=v" pairs
// joined for a single-line summary, sorted for a stable render (map
// iteration order isn't).
func advertisedServiceTXT(svc *mdnsresponder.ServiceSpec) string {
	if len(svc.TXT) == 0 {
		return ""
	}
	keys := make([]string, 0, len(svc.TXT))
	for k := range svc.TXT {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	parts := make([]string, 0, len(keys))
	for _, k := range keys {
		parts = append(parts, k+"="+svc.TXT[k])
	}
	return strings.Join(parts, " ")
}

templ advertisedServiceRow(svc *mdnsresponder.ServiceSpec) {
	<div class="flex items-center justify-between rounded bg-bramble-bg px-3 py-2 text-sm">
		<span>
			<span class="font-mono font-medium">{ svc.Type }</span>
			<span class="text-bramble-muted ml-2">{ svc.Name }</span>
			if txt := advertisedServiceTXT(svc); txt != "" {
				<span class="text-bramble-muted ml-2 font-mono text-xs">{ txt }</span>
			}
		</span>
		<span class="text-bramble-muted font-mono text-xs">:{ strconv.Itoa(int(svc.Port)) }</span>
	</div>
}

templ vlanRow(v model.VLAN) {
	<div class="flex items-center justify-between rounded bg-bramble-bg px-3 py-2 text-sm">
		<span>
			<span class="font-mono font-medium">{ v.Name }</span>
			<span class="text-bramble-muted ml-2 select-all">{ strings.Join(v.CIDRs, ", ") }</span>
		</span>
		<span class="flex items-center gap-3">
			<button
				hx-get={ PathSettings + "/vlans/" + v.Name + "/edit" }
				hx-target="#content"
				hx-swap="innerHTML"
				type="button"
				class="inline-flex items-center gap-1 text-bramble-primary hover:underline text-xs"
			>
				@iconPencil("w-3 h-3")
				Edit
			</button>
			<button
				hx-delete={ PathSettings + "/vlans/" + v.Name }
				hx-target="#content"
				hx-swap="innerHTML"
				hx-confirm={ "Delete VLAN " + v.Name + "? Any records overriding it will keep their override entries but they'll no longer apply." }
				type="button"
				class="inline-flex items-center gap-1 text-bramble-danger hover:underline text-xs"
			>
				@iconTrash("w-3 h-3")
				Delete
			</button>
		</span>
	</div>
}

templ mdnsServiceTypesModeOption(value, label string, types []string) {
	if value == mdnsServiceTypesMode(types) {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

// mdnsServiceTypesMode derives which of the four service_types sentinel
// states (plugins/mdnsbridge/listener.go) the current setting represents,
// so the mode select can be preselected accurately — an explicit choice
// instead of inferring "none" from a blank text field, which made saving
// "none" look like it silently turned into "default" on the next render.
func mdnsServiceTypesMode(types []string) string {
	switch {
	case len(types) == 0:
		return "none"
	case len(types) == 1 && strings.EqualFold(types[0], "default"):
		return "default"
	case len(types) == 1 && strings.EqualFold(types[0], "all"):
		return "all"
	default:
		return "custom"
	}
}

// mdnsServiceTypesCustomValue shows the raw list only in "custom" mode —
// otherwise the field is unused, so leave it blank rather than echoing a
// sentinel value the user didn't type.
func mdnsServiceTypesCustomValue(types []string) string {
	if mdnsServiceTypesMode(types) != "custom" {
		return ""
	}
	return strings.Join(types, ", ")
}
