package ui

// Base is the root document: nav + content slot + footer. Used for full-page
// (non-htmx) requests; htmx fragment requests render just the inner
// templ.Component and skip this wrapper (see internal/gui/handlers_ui.go).
templ Base(title string, active string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — BrambleGate</title>
			// Anti-flash: apply the stored theme before first paint.
			<script>(function(){var t=localStorage.getItem('bramble-theme')||'system';document.documentElement.setAttribute('data-theme',t);}());</script>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/theme.js"></script>
			<script src="/static/js/toast.js"></script>
		</head>
		<body class="h-full bg-bramble-bg text-bramble-text flex flex-col">
			@Topbar(active)
			<main id="content" class="flex-1 pt-8 px-6 pb-10 max-w-5xl w-full mx-auto">
				{ children... }
			</main>
			@PageFooter()
			// Lives outside #content so htmx's hx-target="#content" swaps never
			// clear it; toasts arrive via hx-swap-oob from any handler/page (see
			// toast.templ) and are self-dismissing (see static/js/toast.js).
			<div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none" aria-live="polite"></div>
			// A single reusable confirm dialog: static/js/confirm.js intercepts
			// htmx's htmx:confirm event (fired for every hx-confirm="...") and
			// shows this instead of the native browser confirm() — no change
			// needed to any hx-confirm attribute elsewhere.
			<div id="confirm-dialog" class="hidden fixed inset-0 z-50 grid place-items-center p-4 bg-black/40">
				<div class="w-full max-w-sm rounded border border-bramble-border bg-bramble-bg-card2 shadow-lg p-4">
					<div class="flex items-start gap-3">
						@iconAlertTriangle("w-5 h-5 shrink-0 text-bramble-danger mt-0.5")
						<p id="confirm-dialog-message" class="text-sm"></p>
					</div>
					<div class="mt-4 flex justify-end gap-2">
						<button type="button" data-confirm-cancel class="px-3 py-1.5 rounded border border-bramble-border text-sm">Cancel</button>
						<button type="button" data-confirm-ok class="px-3 py-1.5 rounded border border-bramble-danger text-bramble-danger text-sm font-medium hover:bg-bramble-danger/10">Confirm</button>
					</div>
				</div>
			</div>
			<script src="/static/js/confirm.js"></script>
		</body>
	</html>
}

templ Topbar(active string) {
	<header class="border-b border-bramble-border px-6 py-3 flex items-center justify-between gap-6">
		<div class="flex items-center gap-6">
			<span class="font-heading font-semibold text-lg text-bramble-primary tracking-wide">BrambleGate</span>
			<nav class="flex items-center gap-1">
				@navLink(PathDashboard, "Dashboard", active == PathDashboard)
				@navLink(PathRecords, "Records", active == PathRecords)
				@navLink(PathMDNS, "mDNS", active == PathMDNS)
				@navLink(PathSettings, "Settings", active == PathSettings)
			</nav>
		</div>
		@ThemeToggle()
	</header>
}

templ navLink(href string, label string, active bool) {
	if active {
		<a href={ templ.SafeURL(href) } class="px-3 py-1.5 rounded text-sm font-medium text-bramble-primary border border-bramble-primary">
			{ label }
		</a>
	} else {
		<a href={ templ.SafeURL(href) } class="px-3 py-1.5 rounded text-sm text-bramble-text border border-transparent hover:text-bramble-primary transition-colors">
			{ label }
		</a>
	}
}

templ ThemeToggle() {
	<div class="flex items-center rounded border border-bramble-border overflow-hidden text-xs">
		@themeBtn("light", "Light")
		@themeBtn("dark", "Dark")
		@themeBtn("system", "Auto")
	</div>
}

templ themeBtn(theme, label string) {
	<button data-theme-btn={ theme } aria-pressed="false" class="flex items-center gap-1 px-2 py-1 border-l border-bramble-border first:border-l-0" type="button">
		switch theme {
			case "light":
				@iconSun("w-3.5 h-3.5")
			case "dark":
				@iconMoon("w-3.5 h-3.5")
			default:
				@iconMonitor("w-3.5 h-3.5")
		}
		{ label }
	</button>
}

templ PageFooter() {
	<footer class="border-t border-bramble-border px-6 py-2 text-xs text-bramble-muted text-center">
		BrambleGate <span class="text-bramble-primary">{ AppVersion }</span>
	</footer>
}
