#!/usr/bin/env bash
set -euo pipefail

# Finds the nearest ancestor tag of CURRENT_TAG that has a published
# (non-draft) GitHub Release. Tags are immutable and never deleted here, but
# a release for a given tag can fail to publish (goreleaser creates it as a
# draft; `undraft` only flips it live once every job succeeds). Diffing the
# changelog against such a tag would silently drop its commits from every
# release page's changelog, since no release exists to have shown them.
# Skipping past unpublished tags keeps the changelog contiguous.
#
# When CURRENT_TAG is itself a stable tag (no prerelease suffix), prefer the
# nearest published *stable* tag over a prerelease one. This matters when a
# stable tag lands on the same commit as its last prerelease (e.g.
# v1.2.0-rc.1 promoted straight to v1.2.0): diffing against v1.2.0-rc.1 would
# yield an empty commit range and drop every change already accumulated
# across v1.2.0's alpha/beta/rc tags from the stable release notes. If there
# is no prior stable tag at all (this is the first stable release, but
# prereleases came before it), fall back to the nearest published tag of any
# kind so that history still isn't discarded — only true first-ever releases
# get the caller's "Initial release" fallback (empty output here).

CURRENT_TAG="${1:-}"
if [[ -z "$CURRENT_TAG" ]]; then
  echo "Usage: $0 <current_tag>" >&2
  exit 1
fi

# Mirrors .github/scripts/check-semver.sh's has_prerelease().
is_prerelease() {
  local t="${1#v}"
  [[ "$t" =~ ^[0-9]+\.[0-9]+\.[0-9]+- ]]
}

PUBLISHED_TAGS=$(gh release list --limit 1000 --json tagName,isDraft,createdAt \
  --jq '[.[] | select(.isDraft == false)] | sort_by(.createdAt) | reverse | .[].tagName')

CANDIDATES=$(git tag --sort=-creatordate --merged "$CURRENT_TAG")

if ! is_prerelease "$CURRENT_TAG"; then
  # Stable release: prefer the nearest published stable ancestor tag.
  for tag in $CANDIDATES; do
    [[ "$tag" == "$CURRENT_TAG" ]] && continue
    is_prerelease "$tag" && continue
    if grep -qxF "$tag" <<< "$PUBLISHED_TAGS"; then
      echo "$tag"
      exit 0
    fi
  done
fi

# Prerelease target, or a stable target with no prior stable release: fall
# back to the nearest published tag of any kind.
for tag in $CANDIDATES; do
  [[ "$tag" == "$CURRENT_TAG" ]] && continue
  if grep -qxF "$tag" <<< "$PUBLISHED_TAGS"; then
    echo "$tag"
    exit 0
  fi
done